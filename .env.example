# ===========================================
# Slotly — Service Booking & Client Portal
# Environment Variables
# ===========================================

# ----- DATABASE -----
# Neon PostgreSQL connection string
# Get yours at https://neon.tech (free tier available)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ----- AUTHENTICATION (Better Auth) -----
# A random secret string for signing sessions/tokens (min 32 chars)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"

# The public URL of your application
BETTER_AUTH_URL="http://localhost:3000"

# ----- EMAIL (Resend) -----
# Resend API key for transactional emails (starts with re_)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# Sender email address
# For a verified domain in Resend, use an authorized address on that domain, e.g.:
# EMAIL_FROM="Slotly <noreply@yourdomain.com>" or "Slotly <bookings@yourdomain.com>"
# If testing without a domain, you can use: onboarding@resend.dev (sends only to your account email)
EMAIL_FROM="Slotly <noreply@yourdomain.com>"

# ----- APPLICATION -----
# Public URL for the frontend (used in emails, links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- ADMIN SETUP -----
# Initial admin email (used by seed script to provision first admin)
ADMIN_SETUP_EMAIL="admin@example.com"
# Initial admin password (used by seed script, change immediately after first login)
ADMIN_SETUP_PASSWORD="ChangeThisPassword123!"
